{
  "components": {
    "schemas": {
      "Action": {
        "additionalProperties": false,
        "properties": {
          "action_type": {
            "enum": [
              "TRANSFER",
              "NEW_ISSUANCE"
            ],
            "title": "Action Type",
            "type": "string"
          },
          "allocations": {
            "description": "1–100 allocations; zero shares allowed only for NEW_ISSUANCE",
            "items": {
              "$ref": "#/components/schemas/Allocation"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Allocations",
            "type": "array"
          },
          "price_idr_per_share": {
            "anyOf": [
              {
                "maxLength": 19,
                "pattern": "^(?:0|[1-9][0-9]{0,15})(?:\\.[0-9]{1,2})?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Idr Per Share"
          },
          "seller_ref": {
            "anyOf": [
              {
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seller Ref"
          }
        },
        "required": [
          "action_type",
          "allocations"
        ],
        "title": "Action",
        "type": "object"
      },
      "Allocation": {
        "additionalProperties": false,
        "properties": {
          "controller": {
            "anyOf": [
              {
                "enum": [
                  "TRUE",
                  "FALSE",
                  "UNKNOWN"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Controller"
          },
          "controller_affiliate": {
            "anyOf": [
              {
                "enum": [
                  "TRUE",
                  "FALSE",
                  "UNKNOWN"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Controller Affiliate"
          },
          "director_commissioner": {
            "anyOf": [
              {
                "enum": [
                  "TRUE",
                  "FALSE",
                  "UNKNOWN"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Director Commissioner"
          },
          "eligibility": {
            "anyOf": [
              {
                "enum": [
                  "ELIGIBLE",
                  "INELIGIBLE",
                  "UNKNOWN"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eligibility"
          },
          "evidence_ref": {
            "anyOf": [
              {
                "maxLength": 200,
                "pattern": "^fixture://[a-z0-9_/-]{1,180}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Ref"
          },
          "holder_ref": {
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "title": "Holder Ref",
            "type": "string"
          },
          "holder_type": {
            "anyOf": [
              {
                "enum": [
                  "PERSON",
                  "ORGANIZATION",
                  "AGGREGATE"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Holder Type"
          },
          "restricted": {
            "anyOf": [
              {
                "enum": [
                  "TRUE",
                  "FALSE",
                  "UNKNOWN"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Restricted"
          },
          "shares": {
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Shares",
            "type": "integer"
          },
          "treasury": {
            "anyOf": [
              {
                "enum": [
                  "TRUE",
                  "FALSE",
                  "UNKNOWN"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Treasury"
          }
        },
        "required": [
          "holder_ref",
          "shares"
        ],
        "title": "Allocation",
        "type": "object"
      },
      "CSVBody": {
        "additionalProperties": false,
        "properties": {
          "csv_content": {
            "maxLength": 5242880,
            "title": "Csv Content",
            "type": "string"
          }
        },
        "required": [
          "csv_content"
        ],
        "title": "CSVBody",
        "type": "object"
      },
      "CompanyBody": {
        "additionalProperties": false,
        "properties": {
          "board": {
            "const": "DEMO_STANDARD",
            "default": "DEMO_STANDARD",
            "title": "Board",
            "type": "string"
          },
          "code": {
            "default": "DEMO-001",
            "enum": [
              "DEMO-001",
              "DEMO-002",
              "DEMO-003",
              "DEMO-004",
              "DEMO-005"
            ],
            "title": "Code",
            "type": "string"
          },
          "demo": {
            "const": true,
            "default": true,
            "title": "Demo",
            "type": "boolean"
          },
          "legal_name": {
            "maxLength": 64,
            "pattern": "^DEMO[ A-Z0-9_-]{0,60}$",
            "title": "Legal Name",
            "type": "string"
          }
        },
        "required": [
          "legal_name"
        ],
        "title": "CompanyBody",
        "type": "object"
      },
      "CreateUserBody": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 12,
            "title": "Password",
            "type": "string"
          },
          "role": {
            "enum": [
              "viewer",
              "analyst",
              "reviewer",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password",
          "role"
        ],
        "title": "CreateUserBody",
        "type": "object"
      },
      "DemoReport": {
        "additionalProperties": false,
        "properties": {
          "actions": {
            "items": {
              "$ref": "#/components/schemas/Action"
            },
            "maxItems": 2,
            "minItems": 1,
            "title": "Actions",
            "type": "array"
          },
          "company_id": {
            "maxLength": 64,
            "title": "Company Id",
            "type": "string"
          }
        },
        "required": [
          "company_id",
          "actions"
        ],
        "title": "DemoReport",
        "type": "object"
      },
      "DemoSimulation": {

            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Holding": {
        "additionalProperties": false,
        "properties": {
          "controller": {
            "default": "FALSE",
            "enum": [
              "TRUE",
              "FALSE",
              "UNKNOWN"
            ],
            "title": "Controller",
            "type": "string"
          },
          "controller_affiliate": {
            "default": "FALSE",
            "enum": [
              "TRUE",
              "FALSE",
              "UNKNOWN"
            ],
            "title": "Controller Affiliate",
            "type": "string"
          },
          "director_commissioner": {
            "default": "FALSE",
            "enum": [
              "TRUE",
              "FALSE",
              "UNKNOWN"
            ],
            "title": "Director Commissioner",
            "type": "string"
          },
          "eligibility": {
            "default": "UNKNOWN",
            "enum": [
              "ELIGIBLE",
              "INELIGIBLE",
              "UNKNOWN"
            ],
            "title": "Eligibility",
            "type": "string"
          },
          "evidence_ref": {
            "anyOf": [
              {
                "maxLength": 200,
                "pattern": "^fixture://[a-z0-9_/-]{1,180}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Ref"
          },
          "holder_ref": {
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "title": "Holder Ref",
            "type": "string"
          },
          "holder_type": {
            "default": "ORGANIZATION",
            "enum": [
              "PERSON",
              "ORGANIZATION",
              "AGGREGATE"
            ],
            "title": "Holder Type",
            "type": "string"
          },
          "restricted": {
            "default": "FALSE",
            "enum": [
              "TRUE",
              "FALSE",
              "UNKNOWN"
            ],
            "title": "Restricted",
            "type": "string"
          },
          "shares": {
            "maximum": 9007199254740991.0,
            "minimum": 0.0,
            "title": "Shares",
            "type": "integer"
          },
          "source_as_of_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source As Of Date"
          },
          "treasury": {
            "default": "FALSE",
            "enum": [
              "TRUE",
              "FALSE",
              "UNKNOWN"
            ],
            "title": "Treasury",
            "type": "string"
          }
        },

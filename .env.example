# FloatPath authenticated workspace. No default user/password or bearer token.
DATABASE_URL=sqlite:///./floatpath.db

# Local HTTP only; set true behind HTTPS for deployments.
FLOATPATH_COOKIE_SECURE=false
FLOATPATH_PUBLIC_DEMO=false
FLOATPATH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional machine clients in the same synthetic workspace; not browser login.
# Generate separate values: python -c "import secrets; print(secrets.token_hex(32))"
FLOATPATH_ANALYST_TOKEN=
FLOATPATH_REVIEWER_TOKEN=

# Compose requires a generated hex password; do not commit the value.
POSTGRES_PASSWORD=

# Frontend: local development (copy apps/web/.env.example to .env.local).
INTERNAL_API_URL=http://127.0.0.1:8000

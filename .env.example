# FloatPath Intelligence - Environment Configuration Example
# Synthetic prototype / demo sandbox defaults

# API Server
FLOATPATH_ENV=development
FLOATPATH_HOST=127.0.0.1
FLOATPATH_PORT=8000
FLOATPATH_LOG_LEVEL=info

# Database: local SQLite; use PostgreSQL for the Compose stack.
DATABASE_URL=sqlite:///./floatpath.db
# Compose requires a generated alphanumeric password; do not commit the value.
POSTGRES_PASSWORD=

# Private endpoints are disabled until separate random tokens are configured.
# Generate each value: python -c "import secrets; print(secrets.token_hex(32))"
# Single synthetic workspace only; not production identity management.
FLOATPATH_ANALYST_TOKEN=
FLOATPATH_REVIEWER_TOKEN=

# Web Frontend
INTERNAL_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_ENV=demo
PORT=3000

# Security / CORS
FLOATPATH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI / Document Extraction (Optional - set to use OpenAI candidate extraction)
# In MVP/demo sandbox, leave unset for deterministic manual/fixture fallback
OPENAI_API_KEY=
